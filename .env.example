# URL base da API Gama/GSync (documentação "Integração Blip - Módulo CS")
GSYNC_BASE_URL=https://gsync.com.br

# Credenciais da conta de serviço dedicada à integração com a Blip
GSYNC_LOGIN=
GSYNC_PASSWORD=

# Segredo usado para criptografar/assinar o token que vai na URL do link de checkout.
# Gere um valor aleatório forte, por exemplo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=

# Chave usada para autorizar quem pode GERAR links (POST /api/links).
# Só quem tiver essa chave (ex: o próprio fluxo da Blip, ou você via script) pode mintar um link novo.
INTERNAL_API_KEY=

# URL pública onde este app vai ficar hospedado (usada para montar o link final).
# Em desenvolvimento local, pode deixar http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
